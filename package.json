    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "dotenv": "^18.0.8",
    "express": "^5.1.0",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.19.0",
    "multer": "^2.0.2",
    "mysql2": "^3.24.6",
    "openseadragon": "^6.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
