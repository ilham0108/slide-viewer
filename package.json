{
  "name": "slide_viewers",
  "version": "1.0.0",
  "description": "Biozatix whole-slide image viewer",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "concurrently -k -n server,client,tiles -c blue,magenta,green \"nodemon index.js\" \"vite\" \"node scripts/tile-service.js\"",
    "dev:server": "nodemon index.js",
    "dev:client": "vite",
    "dev:tiles": "node scripts/tile-service.js",
    "build": "vite build",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start:tiles": "node scripts/tile-service.js"
  },
