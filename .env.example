PORT=3000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=biozatix_slide_viewer
MYSQL_CONNECTION_LIMIT=10

# Authentication. SESSION_SECRET must be a long random string, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# SESSION_MAX_AGE_HOURS=12   # idle time before a user must log in again
# COOKIE_SECURE=false        # set true when served over HTTPS
# TRUST_PROXY=               # e.g. 1 when running behind nginx
# ADMIN_PASSWORD=            # password of the first "admin" user (default admin123)

# Upload (optional).
# UPLOAD_TIMEOUT_MINUTES=120 # max duration of one upload request

# Tile service (tile-service/, read by both Node and Python; optional).
# TILE_SERVICE_HOST=127.0.0.1 # keep 127.0.0.1: "localhost" is slow on Windows
# TILE_SERVICE_PORT=3100
# TILE_SERVICE_THREADS=8
# TILE_CACHE_DIR=storage/tile-cache
# TILE_CACHE_MAX_GB=5        # least recently used tiles are removed past this; 0 disables
# TILE_JPEG_QUALITY=80

# Logging (optional).
# LOG_LEVEL=info             # debug | info | warn | error
# LOG_DIR=logs               # relative to the project folder
# LOG_RETENTION_DAYS=30      # daily app/error logs older than this are deleted
